{
  "profiles": {
    "ShutterStreamApi": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "JwtValidIssuer": "https://localhost:7250",
        "JwtValidAudience": "shutterstream",
        "JwtKey": "shutterstream-dev-key-123123123123123123123123123123123123123123123123123123123123",
        "PhotoLibraryPath": "DevPhotoLibrary",
        "PhotoCachePath": "DevPhotoCache"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7250;http://localhost:5060"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/swagger",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "8081",
        "ASPNETCORE_HTTP_PORTS": "8080"
      },
      "publishAllPorts": true,
      "useSSL": true
    }
  },
  "$schema": "http://json.schemastore.org/launchsettings.json"
}
