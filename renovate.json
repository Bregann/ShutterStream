{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/London",
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "3 days",
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Bundle every minor and patch update into one weekly PR, auto-merged when CI passes",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "description": "Major updates get their own PR and always wait for review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": ".NET major versions (SDK images, Microsoft.* packages) need manual review",
      "matchPackageNames": [
        "mcr.microsoft.com/dotnet/**",
        "Microsoft.**",
        "System.**",
        "Npgsql.**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": ".NET major upgrade",
      "automerge": false
    },
    {
      "description": "Next.js minor releases can change behaviour, so review them",
      "matchPackageNames": [
        "next",
        "eslint-config-next",
        "@next/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": "Next.js",
      "automerge": false
    },
    {
      "description": "Never offer .NET major versions for the Docker base images: they must change together with TargetFramework in the .csproj files, as a planned upgrade",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/dotnet/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": true,
    "commitMessageAction": "Refresh package-lock.json",
    "prBodyNotes": [
      "Regenerates package-lock.json so dependencies-of-dependencies (where most npm vulnerabilities hide) get updated. If CI fails or the app misbehaves, just close this PR; next week's refresh will try again."
    ]
  },
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20
}
